# Local development only. Never commit your real .env; use Railway > Variables for deployments.
API_ID=
API_HASH=
BOT_TOKEN=
SESSION_STRING=

# ---- optional ----
# EMOJI_PACKS=pack1,pack2
# SOURCE_ORDER=saavn,soundcloud,audius
# ENABLE_YOUTUBE=0          (disable YouTube; enabled by default)
# YOUTUBE_FIRST=1          (try every YouTube proxy/candidate before alternate sources)
# YOUTUBE_FIRST_TIMEOUT=40 (seconds reserved for YouTube before fallback)
# ENABLE_ALTERNATE_SOURCES=1 (allow Audius/SoundCloud fallback after YouTube fails)
# SAAVN_API=https://your-jiosaavn-api.example.com/api
# JAMENDO_CLIENT_ID=
# COOKIES_BASE64=          (optional Netscape/JSON cookies; never commit real cookies)
# COOKIES_TXT=              (optional Netscape/JSON/raw Cookie header text)
# COOKIES_URL=             (optional URL of a Netscape/JSON export; re-downloaded automatically)
# COOKIES_REFRESH=21600    (seconds between COOKIES_URL refreshes; default 6 hours)
# COOKIES_FILE=            (optional path to a cookie file, e.g. /data/cookies.txt on a volume)
# COOKIES_FROM_BROWSER=auto (imports an existing logged-in local browser profile; Railway usually has none)
# YT_PROXY=http://user:pass@host:port,http://user:pass@host2:port
#   Comma/newline separated list. The bot rotates proxies and cools a failed one for
#   YT_PROXY_COOLDOWN seconds (default 300). YouTube stream links are fetched through
#   the same proxy that resolved them.
# YT_PROXY_COOLDOWN=300
# MIN_AUDIO_KBPS=120       (reject lower-bitrate formats; low quality is used only as a last resort)
# YouTube stream URLs are always probed before playback; no setting needed.
# AUDIO_QUALITY=high       (high = 48 kHz stereo; use medium only if crackling persists on a tiny plan)
# AUDIO_NORMALIZE=1        (EBU R128 loudness normalization; set 0 to disable)
# START_DELAY=10
# START_WATCHDOG=0          (set 1 only if you want automatic silent-stream retries)
# BOT_SERVICE_NAME=web      (only this Railway service runs the bot; duplicates stay health-only)
