# Local development only. Never commit your real .env; use Railway > Variables for deployments.
API_ID=
API_HASH=
BOT_TOKEN=
SESSION_STRING=

# ---- optional ----
# EMOJI_PACKS=pack1,pack2
# SOURCE_ORDER=saavn,soundcloud,audius
# ENABLE_YOUTUBE=0          (disable YouTube; enabled by default)
# ENABLE_ALTERNATE_SOURCES=1 (allow Audius/SoundCloud fallback when YouTube is blocked)
# SAAVN_API=https://your-jiosaavn-api.example.com/api
# JAMENDO_CLIENT_ID=
# COOKIES_BASE64=          (optional Netscape/JSON cookies; never commit real cookies)
# COOKIES_TXT=              (optional Netscape/JSON/raw Cookie header text)
# COOKIES_URL=             (optional URL of a Netscape/JSON export; re-downloaded automatically)
# COOKIES_REFRESH=21600    (seconds between COOKIES_URL refreshes; default 6 hours)
# COOKIES_FILE=            (optional path to a cookie file, e.g. /data/cookies.txt on a volume)
# COOKIES_FROM_BROWSER=auto (imports an existing logged-in local browser profile; Railway usually has none)
# START_DELAY=10
